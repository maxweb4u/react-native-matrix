{
  "name": "react-native-matrix",
  "version": "0.1.0",
  "description": "Typed React Native components and hooks for Matrix chat. Zero runtime dependencies.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./crypto": {
      "types": "./lib/typescript/crypto/index.d.ts",
      "react-native": "./src/crypto/index.ts",
      "import": "./lib/module/crypto/index.js",
      "require": "./lib/commonjs/crypto/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/testing",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxweb4u/react-native-matrix.git"
  },
  "keywords": [
    "android",
    "ios",
    "react-native",
    "react",
    "typescript",
    "messenger",
    "chat",
    "matrix",
    "e2ee"
  ],
  "author": "Max Gornostayev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maxweb4u/react-native-matrix/issues"
  },
  "homepage": "https://github.com/maxweb4u/react-native-matrix#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:esm": "tsc -p tsconfig.build.json --module es2020 --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "clean": "rm -rf lib coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "synapse:up": "./scripts/synapse.sh up",
    "synapse:down": "./scripts/synapse.sh down",
    "synapse:reset": "./scripts/synapse.sh reset",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:docs",
    "prepack": "npm run clean && npm run build",
    "check:docs": "node scripts/check-memory-bank.mjs"
  },
  "peerDependencies": {
    "matrix-js-sdk": ">=42.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.0",
    "matrix-js-sdk": "^42.2.0",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "babel-jest": "^30.5.0",
    "jest-environment-node": "^30.5.0",
    "@jest/create-cache-key-function": "^30.5.0"
  }
}
